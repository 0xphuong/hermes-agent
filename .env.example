# Copy thanh .env roi dien gia tri:  cp .env.example .env
#
# LUU Y: file .env NAY chi phuc vu viec thay the bien trong docker-compose.yml
# (compose doc no o thu muc hien tai). No KHAC voi ~/.hermes/.env — file do nam
# tren volume, chua API key cua model va token cac chat platform, do `hermes setup`
# ghi ra, va container tu doc. Dung nham hai file.

# --- Image -------------------------------------------------------------------
# Nen pin tag cu the o production thay vi latest, de nang cap la hanh dong co chu y.
HERMES_IMAGE_TAG=latest

# --- Duong dan du lieu -------------------------------------------------------
HERMES_DATA_DIR=~/.hermes
ROUTER_DATA_DIR=~/.9router

# --- Network -----------------------------------------------------------------
# 127.0.0.1 = chi truy cap tu chinh host (vao dashboard qua SSH tunnel).
# Doi thanh 0.0.0.0 de phoi ra ngoai — chi lam khi da hieu rui ro.
HERMES_BIND_ADDR=127.0.0.1
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
ROUTER_PORT=20128

# --- Dashboard auth (BAT BUOC) -----------------------------------------------
# Trong container dashboard bind 0.0.0.0 nen auth gate luon bat. Thieu 3 bien nay
# container se fail closed ngay luc khoi dong.
# Sinh secret:  openssl rand -hex 32
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=

# --- Claude Code -------------------------------------------------------------
# Token OAuth cho CLI `claude` trong container (image build tu Dockerfile).
# Sinh bang:  claude setup-token
# De trong neu muon login thu cong: docker exec -it hermes env HOME=/opt/data/home claude
CLAUDE_CODE_OAUTH_TOKEN=

# --- Quyen file --------------------------------------------------------------
# Mac dinh runtime chay UID 10000. Neu thu muc data tren host thuoc user khac,
# dat lai cho khop:  id -u  /  id -g
HERMES_PUID=10000
HERMES_PGID=10000

# --- Tai nguyen --------------------------------------------------------------
# Browser tools (Playwright/Chromium) an RAM nhat. Khong dung browser thi 1G du.
HERMES_MEMORY_LIMIT=4G
HERMES_CPU_LIMIT=2.0

# --- API server (tuy chon) ---------------------------------------------------
# Chi can khi bo comment khoi API_SERVER_* trong docker-compose.yml.
# Toi thieu 8 ky tu:  openssl rand -hex 32
# HERMES_API_KEY=
