# Copy to .env and fill in:  cp .env.example .env
#
# NOTE: THIS file only feeds variable substitution in docker-compose.yml (compose
# reads it from the current directory). It is NOT the same as ~/.hermes/.env —
# that one lives on the volume, holds the model API keys and chat-platform
# tokens, is written by `hermes setup`, and is read by the container itself.
# Do not confuse the two.

# --- Image ---------------------------------------------------------------------
# Pin a specific tag in production instead of latest, so upgrading is deliberate.
HERMES_IMAGE_TAG=latest

# --- Data directories ----------------------------------------------------------
HERMES_DATA_DIR=~/.hermes
ROUTER_DATA_DIR=~/.9router
# HOME of the adapter container (the claude CLI's credentials + config).
# This directory MUST be owned by UID 10001 — see the claude-cli-adapter section.
ADAPTER_DATA_DIR=~/.claude-adapter

# --- Network -------------------------------------------------------------------
# 127.0.0.1 = reachable from this host only (use an SSH tunnel for the dashboard).
# Change to 0.0.0.0 to expose it — only once you understand the risk.
HERMES_BIND_ADDR=127.0.0.1
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
ROUTER_PORT=20128

# --- Dashboard auth (REQUIRED) -------------------------------------------------
# The dashboard binds 0.0.0.0 inside the container, so the auth gate is always on.
# Without these three the container fails closed at startup.
# Generate a secret:  openssl rand -hex 32
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=

# --- Claude Code ---------------------------------------------------------------
# OAuth token for the `claude` CLI inside the container (image built from Dockerfile).
# Generate with:  claude setup-token
# Leave empty to log in manually: docker exec -it hermes env HOME=/opt/data/home claude
CLAUDE_CODE_OAUTH_TOKEN=

# --- File ownership ------------------------------------------------------------
# The runtime defaults to UID 10000. If the host data directory belongs to another
# user, match it here:  id -u  /  id -g
HERMES_PUID=10000
HERMES_PGID=10000

# --- Resources -----------------------------------------------------------------
# Browser tools (Playwright/Chromium) are the memory hog. Without them 1G is plenty.
HERMES_MEMORY_LIMIT=4G
HERMES_CPU_LIMIT=2.0

# --- API server (optional) -----------------------------------------------------
# Only needed once you uncomment the API_SERVER_* block in docker-compose.yml.
# Minimum 8 characters:  openssl rand -hex 32
# HERMES_API_KEY=

# --- claude-cli-adapter --------------------------------------------------------
# Wraps the `claude` CLI in an HTTP API. The ADAPTER_ prefix keeps these out of
# hermes' own model configuration — compose maps them to ANTHROPIC_* inside the
# container.
#
# Pick ONE of the two modes; leave the other one empty.
#
# Mode 1 — token via 9router (default, recommended once 9router is running):
#   the base URL defaults to http://9router:20128 (container name, same network).
#   Only set it to reach a different gateway.
# ADAPTER_ANTHROPIC_BASE_URL=http://9router:20128
# Key generated in the 9router UI (http://127.0.0.1:20128) -> API Keys.
ADAPTER_ANTHROPIC_AUTH_TOKEN=
# Use INSTEAD OF ADAPTER_ANTHROPIC_AUTH_TOKEN if the endpoint expects an
# x-api-key header. Setting both makes the container refuse to start.
# ADAPTER_ANTHROPIC_API_KEY=
#
# Mode 2 — subscription: clear both variables above and set this instead
# (generate it with `claude setup-token` on a machine that is already logged in).
# ADAPTER_CLAUDE_CODE_OAUTH_TOKEN=

# Model used when a client sends no "model" field. Behind 9router the names are
# namespaced; a plain Anthropic name (claude-sonnet-5) will 404.
ADAPTER_DEFAULT_MODEL=cc/claude-sonnet-5

# The adapter has NO auth of its own. Keep 127.0.0.1 unless a reverse proxy in
# front of it authenticates — this variable is DELIBERATELY separate from
# HERMES_BIND_ADDR.
ADAPTER_BIND_ADDR=127.0.0.1
ADAPTER_PORT=8082

# Pin a specific tag in production; :latest moves under you.
ADAPTER_IMAGE_TAG=latest
ADAPTER_MEMORY_LIMIT=2G
ADAPTER_CPU_LIMIT=2.0

# Data directory: set at the top of this file (ADAPTER_DATA_DIR).
# The container runs as UID 10001 and has NO PUID/PGID like hermes — it starts
# directly as the `app` user and cannot chown anything itself. The host directory
# must be owned by 10001:10001:
#   sudo chown -R 10001:10001 ~/.claude-adapter
# setup.sh does this for you.
