# Copy to .env and fill in:  cp .env.example .env
#
# NOTE: THIS file only feeds variable substitution in docker-compose.yml (compose
# reads it from the current directory). It is NOT the same as ~/.hermes/.env —
# that one lives on the volume, holds the model API keys and chat-platform
# tokens, is written by `hermes setup`, and is read by the container itself.
# Do not confuse the two.

# --- Image ---------------------------------------------------------------------
# Pin a specific tag in production instead of latest, so upgrading is deliberate.
HERMES_IMAGE_TAG=latest

# --- Which services to run -----------------------------------------------------
# Read by the compose CLI itself, so a bare `docker compose up -d` in this
# directory starts the right set without anyone remembering `--profile`.
#   (empty)  hermes only — the default
#   router   also 9router + headroom
# setup.sh writes this from your answer; `./setup.sh --with-router` sets it too.
COMPOSE_PROFILES=

# --- Data directories ----------------------------------------------------------
HERMES_DATA_DIR=~/.hermes
# Only used when COMPOSE_PROFILES=router.
ROUTER_DATA_DIR=~/.9router

# --- Network -------------------------------------------------------------------
# 127.0.0.1 = reachable from this host only (use an SSH tunnel for the dashboard).
# 0.0.0.0    = anything that can route to this machine.
# setup.sh asks for this and writes the answer here; setting HERMES_BIND_ADDR in
# the environment skips the question.
HERMES_BIND_ADDR=127.0.0.1
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119
ROUTER_PORT=20128

# --- Dashboard auth (REQUIRED) -------------------------------------------------
# The dashboard binds 0.0.0.0 inside the container, so the auth gate is always on.
# Without these three the container fails closed at startup.
# Generate a secret:  openssl rand -hex 32
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=

# --- Claude Code ---------------------------------------------------------------
# OAuth token for the `claude` CLI inside the container (image built from Dockerfile).
# Generate with:  claude setup-token
# Leave empty to log in manually: docker exec -it -u hermes hermes claude
CLAUDE_CODE_OAUTH_TOKEN=

# --- File ownership ------------------------------------------------------------
# The runtime defaults to UID 10000. If the host data directory belongs to another
# user, match it here:  id -u  /  id -g
HERMES_PUID=10000
HERMES_PGID=10000

# --- Resources -----------------------------------------------------------------
# Browser tools (Playwright/Chromium) are the memory hog. Without them 1G is plenty.
HERMES_MEMORY_LIMIT=4G
HERMES_CPU_LIMIT=2.0

# --- API server (optional) -----------------------------------------------------
# Only needed once you uncomment the API_SERVER_* block in docker-compose.yml.
# Minimum 8 characters:  openssl rand -hex 32
# HERMES_API_KEY=

# --- claude-proxy (inside the hermes container) --------------------------------
# Only present in the image built from ./Dockerfile (./setup.sh --with-claude-code).
# An s6-supervised service running claude_proxy/server.py, which wraps the local
# `claude` CLI in an Anthropic Messages API. Hermes reaches it at
# http://localhost:8082 — same container, no network hop, nothing published.
CLAUDE_PROXY_ENABLED=1
CLAUDE_PROXY_PORT=8082

# LEAVE THESE TWO EMPTY unless you know you need them. Empty means the `claude`
# CLI talks to api.anthropic.com with the subscription login stored in
# /opt/data/.claude — which is the whole point of the proxy.
#
# Setting them sends the CLI through a gateway instead, and that breaks Claude
# models on any router that namespaces them: the CLI expands `--model sonnet`
# into `claude-sonnet-5`, a name a router serving `cc/claude-sonnet-5` does not
# have, so every call 404s and it looks like the proxy is broken.
# Never point them at the proxy's own port — that is an infinite loop.
# CLAUDE_PROXY_UPSTREAM_URL=
# CLAUDE_PROXY_UPSTREAM_TOKEN=

# HOME for the `claude` CLI. Default /opt/data, which is where an interactive
# `docker exec -it -u hermes hermes claude` login lands, because that is the
# hermes user's own home in the base image. Change it and the service stops
# seeing your login.
# CLAUDE_PROXY_HOME=/opt/data
