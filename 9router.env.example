# Copy to 9router.env and fill in:  cp 9router.env.example 9router.env
#
# This file is for the 9router container only. It deliberately does NOT use the
# shared compose .env — that one holds hermes credentials (dashboard password,
# CLAUDE_CODE_OAUTH_TOKEN) and env_file would load all of them into 9router.

# --- Required ------------------------------------------------------------------
# Generate a secret:  openssl rand -hex 32
JWT_SECRET=
INITIAL_PASSWORD=

# DATA_DIR is overridden to /app/data in docker-compose.yml (matching the volume
# mount). The value here is only relevant when running outside Docker.
DATA_DIR=/app/data

# --- Runtime -------------------------------------------------------------------
PORT=20128
NODE_ENV=production

# --- Security / ops ------------------------------------------------------------
API_KEY_SECRET=
MACHINE_ID_SALT=
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# Set to true when running behind a TLS-terminating reverse proxy
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# --- Cloud sync ----------------------------------------------------------------
# Must point back at this running instance so the internal sync job can reach
# /api/sync/cloud. localhost here is the 9router container itself, not the host.
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# --- Outbound proxy (optional) -------------------------------------------------
# Lowercase works too: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# --- SearXNG (optional) --------------------------------------------------------
# Endpoint for the auth-free web-search provider.
# SEARXNG_URL=http://searxng:8080/search
