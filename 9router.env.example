# Copy thanh 9router.env roi dien gia tri:  cp 9router.env.example 9router.env
#
# File nay chi danh cho container 9router. KHONG dung .env chung cua compose —
# .env do chua credential cua hermes (dashboard password, CLAUDE_CODE_OAUTH_TOKEN)
# va env_file se nap toan bo bien vao container 9router.

# --- Bat buoc ----------------------------------------------------------------
# Sinh secret:  openssl rand -hex 32
JWT_SECRET=
INITIAL_PASSWORD=

# DATA_DIR bi ghi de thanh /app/data trong docker-compose.yml (khop volume mount).
# Gia tri o day chi de tham khao khi chay ngoai Docker.
DATA_DIR=/app/data

# --- Runtime -----------------------------------------------------------------
PORT=20128
NODE_ENV=production

# --- Bao mat / ops -----------------------------------------------------------
API_KEY_SECRET=
MACHINE_ID_SALT=
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# Dat true khi dat sau reverse proxy co TLS
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# --- Cloud sync --------------------------------------------------------------
# Phai tro ve chinh instance dang chay de internal sync job goi duoc /api/sync/cloud.
# localhost o day la chinh container 9router, khong phai host.
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# --- Outbound proxy (tuy chon) -----------------------------------------------
# Ban chu thuong cung duoc: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# --- SearXNG (tuy chon) ------------------------------------------------------
# Endpoint cho provider web-search khong can auth.
# SEARXNG_URL=http://searxng:8080/search
